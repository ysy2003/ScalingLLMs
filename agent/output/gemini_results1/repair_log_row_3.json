gin-bottom: 40px;\n            font-size: 1.05em;\n        }\n\n        .info-box-icon {\n            font-size: 1.2em;\n            color: var(--light-blue-border);\n            line-height: 1.6; /* Align with text */\n        }\n\n        .info-box p {\n            margin: 0;\n        }\n\n        .info-box a {\n            color: var(--link-color);\n        }\n\n        h2 {\n            font-size: 1.6em;\n            font-weight: 600;\n            margin-top: 0;\n            margin-bottom: 15px;\n            color: #333;\n        }\n\n        .chemical-item {\n            margin-bottom: 30px;\n            font-size: 1.05em;\n        }\n\n        .download-data-paragraph {\n            font-size: 1.05em;\n        }\n\n        /* Footer */\n        .footer {\n            background-color: var(--footer-bg);\n            padding: 40px 20px;\n            margin-top: 60px;\n            font-size: 0.9em;\n            color: var(--footer-text);\n        }\n\n        .footer-content {\n            max-width: var(--main-content-width);\n            margin: 0 auto;\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n\n        .footer-logos {\n            display: flex;\n            gap: 15px;\n            margin-bottom: 10px; /* Space between logos and text */\n        }\n\n        .footer-logo-square {\n            width: 40px;\n            height: 40px;\n            background-color: #007bff; /* Blue color for footer logo squares */\n        }\n        .footer-logo-square:nth-child(3) {\n            width: 25px; /* Third square is smaller */\n            height: 25px;\n            align-self: flex-start; /* Align to top of the row */\n        }\n\n\n        .footer p {\n            margin: 0;\n        }\n\n        .footer a {\n            color: var(--link-color);\n        }\n\n        /* Feedback Button */\n        .feedback-button {\n            position: fixed;\n            bottom: 20px;\n            right: 20px;\n     