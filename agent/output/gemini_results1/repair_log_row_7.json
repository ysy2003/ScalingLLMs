        "html_content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Margo's Gift Shop</title>\n    <style>\n        :root {\n            --primary-blue: #0000FF;\n            --text-color-dark: #333;\n            --text-color-light: #f0f0f0;\n            --footer-bg: #2C6E7E;\n            --footer-line: #4A8B9B;\n            --font-family-sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\";\n        }\n\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: var(--font-family-sans);\n            line-height: 1.6;\n            color: var(--text-color-dark);\n            background-color: #fff;\n            display: flex;\n            flex-direction: column;\n            min-height: 100vh;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n        }\n\n        /* Header */\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 20px 0;\n            border-bottom: 1px solid transparent; /* Placeholder for potential border */\n        }\n\n        .header-logo {\n            width: 200px;\n            height: 80px;\n            background-color: var(--primary-blue);\n            margin-left: 20px; /* Adjust based on image */\n        }\n\n        .nav-menu {\n            display: flex;\n            list-style: none;\n            margin-right: 20px; /* Adjust based on image */\n        }\n\n        .nav-menu li {\n            margin-left: 30px;\n        }\n\n        .nav-menu a {\n            text-decoration: none;\n            color: var(--text-color-dark);\n            font-size: 14px;\n            font-weight: 500;\n            letter-spacing: 0.5px;\n            white-space: nowrap;\n        }\n\n        /* Main Content */\n        .main-content {\n            flex-grow: 1;\n            padding: 40px 0;\n        }\n\n        .main-content h1 {\n            font-size: 36px;\n            font-weight: normal;\n            margin-bottom: 30px;\n            margin-left: 20px; /* Align with logo */\n        }\n\n        .main-image-placeholder {\n            width: 100%;\n            max-width: 800px; /* Approximate width from image */\n            height: 400px; /* Approximate height from image */\n            background-color: var(--primary-blue);\n            margin-bottom: 30px;\n            margin-left: 20px; /* Align with heading */\n        }\n\n        .main-text {\n            font-size: 16px;\n            line-height: 1.8;\n            max-width: 800px; /* Match image placeholder width */\n            margin-left: 20px; /* Align with heading */\n        }\n\n        /* Footer */\n        .footer {\n            background-color: var(--footer-bg);\n            color: var(--text-color-light);\n            padding: 60px 0 20px;\n            margin-top: 60px; /* Space above footer */\n        }\n\n        .footer-top {\n            display: flex;\n            flex-wrap: wrap;\n            justify-content: space-between;\n            padding-bottom: 40px;\n        }\n\n        .footer-logo-address {\n            flex: 1 1 250px; /* Allow shrinking, but prefer 250px */\n            margin-right: 30px;\n            margin-bottom: 30px;\n        }\n\n        .footer-logo {\n            width: 120px;\n            height: 60px;\n            background-color: var(--primary-blue);\n            margin-bottom: 20px;\n        }\n\n        .footer-address {\n            font-size: 14px;\n            line-height: 1.5;\n        }\n\n        .footer-column {\n            flex: 1 1 200px; /* Allow shrinking, but prefer 200px */\n            margin-right: 30px;\n            margin-bottom: 30px;\n        }\n\n        .footer-column:last-child {\n            margin-right: 0;\n        }\n\n        .footer-column h4 {\n            font-size: 14px;\n            font-weight: 500;\n            margin-bottom: 20px;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        .footer-column ul {\n            list-style: none;\n        }\n\n        .footer-column ul li {\n            margin-bottom: 10px;\n        }\n\n        .footer-column a,\n        .footer-column p {\n            color: var(--text-color-light);\n            text-decoration: none;\n            font-size: 14px;\n            line-height: 1.5;\n        }\n\n        .footer-column a:hover {\n            text-decoration: underline;\n        }\n\n        .footer-bottom {\n            border-top: 1px solid var(--footer-line);\n            padding-top: 20px;\n            display: flex;\n            flex-wrap: wrap;\n            justify-content: space-between;\n            align-items: center;\n            font-size: 13px;\n            color: var(--text-color-light);\n        }\n\n        .footer-bottom p {\n            margin-bottom: 10px;\n        }\n\n        .footer-bottom span {\n            white-space: nowrap;\n        }\n\n        /* Responsive adjustments */\n        @media (max-width: 768px) {\n            .header {\n                flex-direction: column;\n                align-items: flex-start;\n                padding: 20px;\n            }\n\n            .header-logo {\n                margin-left: 0;\n                margin-bottom: 20px;\n            }\n\n            .nav-menu {\n                flex-direction: column;\n                align-items: flex-start;\n                margin-right: 0;\n            }\n\n            .nav-menu li {\n                margin-left: 0;\n                margin-bottom: 10px;\n            }\n\n            .main-content h1,\n            .main-image-placeholder,\n            .main-text {\n                margin-left: 20px;\n                margin-right: 20px;\n            }\n\n            .main-image-placeholder {\n                height: 250px; /* Adjust height for smaller screens */\n            }\n\n            .footer-top {\n                flex-direction: column;\n                align-items: flex-start;\n            }\n\n            .footer-logo-address,\n            .footer-column {\n                margin-right: 0;\n                width: 100%;\n                max-width: none;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                align-items: flex-start;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .header-logo {\n                width: 150px;\n                height: 60px;\n            }\n\n            .main-content h1 {\n                font-size: 28px;\n            }\n\n            .main-image-placeholder {\n                height: 180px;\n            }\n\n            .footer-logo {\n                width: 100px;\n                height: 50px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header class=\"header container\">\n        <div class=\"header-logo\"></div>\n        <nav>\n            <ul class=\"nav-menu\">\n                <li><a href=\"#\">HOUSEHOLD</a></li>\n                <li><a href=\"#\">GIFTS</a></li>\n                <li><a href=\"#\">PAPER</a></li>\n                <li><a href=\"#\">HOLIDAY</a></li>\n            </ul>\n        </nav>\n    </header>\n\n    <main class=\"main-content container\">\n        <h1>Easter Baskets</h1>\n        <div class=\"main-image-placeholder\"></div>\n        <p class=\"main-text\">\n            Did you know Margo's Gift Shop creates Easter Baskets to order, they have items for young and old. Stop in today and fill your basket up.\n        </p>\n    </main>\n\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-top\">\n                <div class=\"footer-logo-address\">\n                    <div class=\"footer-logo\"></div>\n                    <p class=\"footer-address\">\n                        2058 Utica Square Tulsa, Oklahoma |<br>\n                        [PHONE REDACTED]\n                    </p>\n                </div>\n\n                <div class=\"footer-column\">\n                    <h4>COLLECTIONS</h4>\n                    <ul>\n                        <li><a href=\"#\">Bridal Registry</a></li>\n                        <li><a href=\"#\">Household</a></li>\n                        <li><a href=\"#\">Gifts</a></li>\n                        <li><a href=\"#\">Glassware</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-column\">\n                    <h4>CUSTOMER CARE</h4>\n                    <ul>\n                        <li><a href=\"#\">About</a></li>\n                        <li><a href=\"#\">Contact</a></li>\n                        <li><a href=\"#\">Returns & Shipping</a></li>\n                        <li><a href=\"#\">Privacy Policy</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-column\">\n                    <h4>ABOUT MARGO'S GIFTS</h4>\n                    <p>\n                        Margo's was established in 1935 and is known for its bridal registry. Through the store's vast inventory, brides can register for pottery, linens, home decor, and other fine gifts.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2023, Margo's Gift Shop.</p>\n                <p>\n                    <span>Designed by Janzen Designs</span> | <span>Powered by Shopify</span>\n                </p>\n            </div>\n        </div>\n    </footer>\n</body>\n</html>"
