on: none;\n            transition: color 0.2s ease-in-out;\n        }\n\n        a:hover {\n            color: var(--link-hover-color);\n            text-decoration: underline;\n        }\n        \n        a:focus-visible {\n            outline: 2px solid var(--accent-color);\n            outline-offset: 3px;\n            border-radius: 2px;\n            text-decoration: none;\n        }\n\n        main {\n            flex-grow: 1;\n            padding-top: 4rem;\n            padding-bottom: 4rem;\n        }\n\n        .page-header {\n            text-align: center;\n            padding: 4rem 0;\n            background-color: var(--header-bg-color);\n            border-bottom: 1px solid var(--border-color);\n        }\n\n        .page-header h1 {\n            font-size: clamp(2.5rem, 5vw + 1rem, 3.75rem);\n            margin: 0 0 0.5rem;\n            letter-spacing: -1.5px;\n            text-shadow: 1px 1px 2px var(--shadow-color);\n        }\n\n        .page-header .site-description {\n            font-size: clamp(1.1rem, 2vw + 0.5rem, 1.25rem);\n            color: var(--meta-color);\n            margin: 0;\n            font-family: 'Lora', serif;\n            font-style: italic;\n        }\n\n        .blog-post {\n            background-color: var(--card-bg-color);\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            padding: 2.5rem;\n            box-shadow: 0 4px 12px var(--shadow-color);\n            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;\n        }\n        \n        .blog-post:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);\n        }\n\n        .post-header {\n            margin-bottom: 1.5rem;\n            border-bottom: 1px solid var(--border-color);\n            padding-bottom: 1.5rem;\n        }\n\n        .post-header h2 {\n            font-size: clamp(1.8rem, 4vw + 0.8rem, 2.5rem);\n            margin: 0;\n        }\n\n        .post-header h2 a {\n            color: inherit;\n            text-decoration: none;\n        }\n\n        .post-header h2 a:hover,\n        .post-header h2 a:focus-visible {\n            color: var(--accent-color);\n            text-decoration: none;\n        }\n\n        .post-meta {\n            font-size: 0.9rem;\n            color: var(--meta-color);\n            margin: 0.75rem 0 0 0;\n            font-family: 'Lato', sans-serif;\n            font-weight: 700;\n        }\n\n        .post-content {\n            padding-top: 1rem;\n        }\n\n        .post-content p {\n            font-size: 1.1rem;\n            margin-top: 0;\n            margin-bottom: 1.5em;\n        }\n        \n        .post-content p:last-child {\n            margin-bottom: 0;\n        }\n\n        .page-footer {\n            text-align: center;\n            padding: 3rem 0;\n            font-size: 0.9rem;\n            color: var(--meta-color);\n            background-color: var(--header-bg-color);\n            border-top: 1px solid var(--border-color);\n        }\n\n        .footer-nav ul {\n            list-style: none;\n            padding: 0;\n            margin: 0 0 1.5rem 0;\n            display: flex;\n            justify-content: center;\n            gap: 2rem;\n        }\n\n        .footer-nav a {\n            font-weight: 700;\n        }\n\n        .copyright {\n            margin: 0;\n            font-size: 0.85rem;\n        }\n\n        @media (max-width: 768px) {\n            .blog-post {\n                padding: 2rem;\n            }\n            .page-header {\n                padding: 3rem 0;\n            }\n            main {\n                padding-top: 3rem;\n                padding-bottom: 3rem;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .container {\n                padding-left: 1rem;\n                padding-right: 1rem;\n            }\n            .blog-post {\n                padding: 1.5rem;\n                border-radius: 4px;\n            }\n            .footer-nav ul {\n                flex-direction: column;\n                gap: 0.75rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header class=\"page-header\" role=\"banner\">\n        <div class=\"container\">\n            <h1>Running &amp; Code</h1>\n            <p class=\"site-description\">About software and adventures on foot.</p>\n        </div>\n    </header>\n\n    <main>\n        <div class=\"container\">\n            <article class=\"blog-post\">\n                <header class=\"post-header\">\n                    <h2><a href=\"#\">Meta-Running?</a></h2>\n                    <p class=\"post-meta\">\n                        <time datetime=\"2015-03-16\">March 16, 2015</time>\n                    </p>\n                </header>\n\n                <section class=\"post-content\">\n                    <p>A problem lately: I start running, and within five minutes or so, I start thinking about a title or description for my online training log.</p>\n                    <p>Take today's run, for example. Strava entry about this in my head.</p>\n                    <p>This is a bit of a problem, for me and I think a lot of other people (there is a steady stream of running-selfies out there, for one measure). Sometimes we are too connected; we quantify our runs until we neglect to feel the ground with each step, and we objectify our performance until we no longer feel our lungs fill with each breath.</p>\n                    <p>Short of investing time in learning to meditate or throwing out all training technology (which really is useful), the only two solutions I know of are to run longer and work harder. Working hard or being out a long time, you will eventually get into a zone in which you are present to the reality of the run.</p>\n                    <p>Maybe blogging about it will help.</p>\n                </section>\n            </article>\n        </div>\n    </main>\n\n    <footer class=\"page-footer\" role=\"contentinfo\">\n        <div class=\"container\">\n            <nav class=\"footer-nav\" aria-label=\"Footer navigation\">\n                <ul>\n                    <li><a href=\"#\">My Apps</a></li>\n                    <li><a href=\"#\">Contact</a></li>\n                    <li><a href=\"#\">RSS</a></li>\n                </ul>\n            </nav>\n            <p class=\"copyright\">&copy; 2024 Running &amp; Code</p>\n        </div>\n    </footer>\n</body>\n</html>"
    }
]