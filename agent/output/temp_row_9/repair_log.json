           font-size: 0.7em; /* Smaller superscript */\n            vertical-align: super;\n            line-height: 0; /* Prevent extra line height */\n        }\n\n        /* Separator */\n        hr {\n            border: none;\n            border-top: 1px solid #eee;\n            margin: 40px 0;\n        }\n\n        /* Footer */\n        .footer {\n            font-size: 0.85em;\n            color: #666;\n            line-height: 1.5;\n        }\n        .footer p {\n            margin-bottom: 0.5em;\n        }\n        .footer a {\n            color: #06c;\n            text-decoration: none;\n        }\n        .footer a:hover {\n            text-decoration: underline;\n        }\n\n        /* Responsive adjustments */\n        @media (max-width: 768px) {\n            body {\n                padding: 15px;\n            }\n            .container {\n                padding: 0 10px;\n            }\n            h1 {\n                font-size: 2em;\n            }\n            .header-nav {\n                text-align: center;\n                margin-bottom: 30px;\n            }\n            .header-nav a {\n                display: inline-block;\n                margin: 0 5px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <nav class=\"header-nav\">\n                <a href=\"#\">home</a> | <a href=\"#\">writing</a> | <a href=\"#\">TIL</a> | <a href=\"#\">now</a> | <a href=\"#\">about</a>\n            </nav>\n        </header>\n\n        <main>\n            <article>\n                <header>\n                    <h1>Reorganising a Consul key-value store</h1>\n                    <p class=\"meta\">by <a href=\"#\">David Winterbottom</a> on Monday, 27 March 2017</p>\n                </header>\n\n                <p>If your Consul key-value store is structured as:</p>\n                <pre class=\"code-block\"><code><span class=\"path\">/</span>\n<span class=\"path\">A/</span>\n  <span class=\"va