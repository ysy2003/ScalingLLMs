-header nav a:hover {\n            color: var(--color-accent);\n        }\n\n        h1 {\n            font-size: 2.75rem;\n            color: var(--color-heading);\n            margin: 0 0 1rem 0;\n            line-height: 1.15;\n            font-weight: 800;\n        }\n\n        .article-header .meta {\n            color: var(--color-text-muted);\n            font-size: 0.95rem;\n            display: flex;\n            flex-wrap: wrap;\n            gap: 0.5rem 1rem;\n            margin-bottom: 3rem;\n        }\n\n        .article-header .meta a {\n            color: inherit;\n            text-decoration: none;\n        }\n\n        .article-header .meta a:hover {\n            color: var(--color-accent);\n            text-decoration: underline;\n        }\n\n        p {\n            margin: 0 0 1.5rem 0;\n        }\n\n        a {\n            color: var(--color-accent);\n            text-decoration: none;\n            transition: color 0.2s ease;\n        }\n\n        a:hover {\n            color: var(--color-accent-hover);\n            text-decoration: underline;\n        }\n\n        .highlight-text {\n            font-family: var(--font-mono);\n            font-size: 0.9em;\n            background-color: #eef2ff;\n            color: #4338ca;\n            padding: 0.1em 0.4em;\n            border-radius: 4px;\n        }\n\n        pre {\n            background-color: var(--color-code-bg);\n            color: var(--color-code-text);\n            padding: 1.5rem;\n            border-radius: 8px;\n            overflow-x: auto;\n            font-family: var(--font-mono);\n            font-size: 0.9rem;\n            line-height: 1.6;\n            margin: 0 0 2rem 0;\n        }\n\n        pre code {\n            display: block;\n            white-space: pre;\n        }\n\n        .code-block .comment { color: #6b7280; }\n        .code-block .keyword { color: #93c5fd; }\n        .code-block .option { color: #c4b5fd; }\n        .code-block .string { color: #a7f3d0; }\n        .code-block .number { color: #fca5a5; }\n        .code-block .variable { color: #fca5a5; }\n        .code-block .function { color: #f0abfc; }\n        .code-block .command { color: #6ee7b7; }\n        .code-block .path { color: #a7f3d0; }\n\n        sup {\n            line-height: 0;\n        }\n        \n        sup a {\n            font-weight: 600;\n        }\n\n        .footnotes {\n            margin-top: 3rem;\n            padding-top: 2rem;\n            border-top: 1px solid var(--color-border);\n        }\n\n        .footnotes ol {\n            padding-left: 1.25rem;\n            margin: 0;\n            font-size: 0.9rem;\n            color: var(--color-text-muted);\n        }\n\n        .footnotes li::marker {\n            font-weight: 600;\n            color: var(--color-accent);\n        }\n\n        .footnotes li p {\n            margin: 0 0 1rem 0;\n            display: inline;\n        }\n        \n        .footnotes li a {\n            font-size: 1.2em;\n        }\n\n        hr {\n            border: none;\n            border-top: 1px solid var(--color-border);\n            margin: 4rem 0;\n        }\n\n        .page-footer {\n            font-size: 0.9rem;\n            color: var(--color-text-muted);\n            line-height: 1.6;\n        }\n        \n        .page-footer .footer-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 2rem;\n        }\n\n        .page-footer h3 {\n            font-size: 0.9rem;\n            font-weight: 600;\n            color: var(--color-text);\n            margin: 0 0 0.5rem 0;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n\n        .page-footer p {\n            margin: 0;\n        }\n        \n        .page-footer .footer-meta ul {\n            list-style: none;\n            padding: 0;\n            margin: 0;\n            display: flex;\n            flex-wrap: wrap;\n            gap: 0.5rem;\n        }\n\n        .page-footer .footer-copyright {\n            margin-top: 3rem;\n            padding-top: 2rem;\n            border-top: 1px solid var(--color-border);\n            text-align: center;\n        }\n\n        .sr-only {\n            position: absolute;\n            width: 1px;\n            height: 1px;\n            padding: 0;\n            margin: -1px;\n            overflow: hidden;\n            clip: rect(0, 0, 0, 0);\n            white-space: nowrap;\n            border-width: 0;\n        }\n\n        @media (max-width: 768px) {\n            body {\n                font-size: 16px;\n            }\n            .wrapper {\n                padding: 1.5rem 1rem;\n            }\n            h1 {\n                font-size: 2.25rem;\n            }\n            .page-header {\n                justify-content: center;\n                margin-bottom: 3rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"wrapper\">\n        <header class=\"page-header\">\n            <nav aria-label=\"Primary\">\n                <a href=\"#\">home</a>\n                <a href=\"#\">writing</a>\n                <a href=\"#\">TIL</a>\n                <a href=\"#\">now</a>\n                <a href=\"#\">about</a>\n            </nav>\n        </header>\n\n        <main>\n            <article>\n                <header class=\"article-header\">\n                    <h1>Reorganising a Consul key-value store</h1>\n                    <div class=\"meta\">\n                        <span>by <a href=\"#\">David Winterbottom</a></span>\n                        <time datetime=\"2017-03-27\">Monday, 27 March 2017</time>\n                    </div>\n                </header>\n\n                <div class=\"article-body\">\n                    <p>If your Consul key-value store is structured as:</p>\n                    <pre class=\"code-block\"><code><span class=\"path\">/</span>\n<span class=\"path\">A/</span>\n  <span class=\"variable\">X</span> = <span class=\"number\">1</span>\n  <span class=\"variable\">Z</span> = <span class=\"number\">2</span>\n  <span class=\"variable\">Y</span> = <span class=\"number\">3</span>\n<span class=\"path\">C</span>\n<span class=\"path\">D</span></code></pre>\n\n                    <p>but you now realise you should have namespaced everything within <span class=\"highlight-text\">WEBSERVER/</span> (or something like that):</p>\n                    <pre class=\"code-block\"><code><span class=\"path\">/</span>\n<span class=\"path\">WEBSERVER/</span>\n<span class=\"path\">A/</span>\n  <span class=\"variable\">X</span> = <span class=\"number\">1</span>\n  <span class=\"variable\">Z</span> = <span class=\"number\">2</span>\n  <span class=\"variable\">Y</span> = <span class=\"number\">3</span>\n<span class=\"path\">C</span>\n<span class=\"path\">D</span></code></pre>\n\n                    <p>then this Bash script will help you migrate:</p>\n                    <pre class=\"code-block bash\"><code><span class=\"comment\">#!/bin/bash</span>\n\n<span class=\"keyword\">set</span> <span class=\"option\">-e</span> <span class=\"comment\"># Exit on error</span>\n\n<span class=\"comment\"># Emit \"key value\" lines for all keys in Consul's KV store</span>\n<span class=\"function\">keys_and_values</span>() {\n  <span class=\"comment\"># Recursively fetch all values from Consul but exclude:</span>\n  <span class=\"comment\"># (a) those that end in / (as these are folders)</span>\n  <span class=\"comment\"># (b) those that start with WEBSERVER/ (as that's where we are migrating</span>\n  <span class=\"comment\">#     to).</span>\n  <span class=\"command\">curl</span> <span class=\"option\">-s</span> <span class=\"string\">\"localhost/v1/kv/?recurse\"</span> | <span class=\"command\">jq</span> <span class=\"option\">-r</span> <span class=\"string\">'\n    .[] |\n    select(\n      ( (.Key | endswith(\"/\")) | not) and\n      (.Key | startswith(\"WEBSERVER\") | not)\n    ) |\n    [.Key, \" \", .Value] |\n    add'</span> | <span class=\"keyword\">while</span> <span class=\"keyword\">read</span> <span class=\"variable\">key</span> <span class=\"variable\">b64value</span>\n  <span class=\"keyword\">do</span>\n    <span class=\"comment\"># Consul's REST API returns values base64-encoded so we decode here.</span>\n    <span class=\"command\">echo</span> <span class=\"variable\">$key</span> `<span class=\"command\">echo</span> <span class=\"string\">\"$b64value\"</span> | <span class=\"command\">base64</span> <span class=\"option\">-d</span>`\n  <span class=\"keyword\">done</span>\n}\n\n<span class=\"comment\"># Set a new value in Consul's KV store</span>\n<span class=\"function\">set_key</span>() {\n  <span class=\"variable\">key</span>=<span class=\"variable\">$1</span>\n  <span class=\"variable\">value</span>=<span class=\"variable\">$2</span>\n  <span class=\"command\">curl</span> <span class=\"option\">-s</span> <span class=\"option\">-X</span> <span class=\"keyword\">PUT</span> <span class=\"option\">-d</span> <span class=\"string\">\"$value\"</span> <span class=\"string\">\"localhost/v1/kv/$key\"</span> &gt; <span class=\"path\">/dev/null</span>\n}\n\n<span class=\"function\">migrate_to_webserver_namespace</span>() {\n  <span class=\"function\">keys_and_values</span> | <span class=\"keyword\">while</span> <span class=\"keyword\">read</span> <span class=\"variable\">key</span> <span class=\"variable\">value</span>\n  <span class=\"keyword\">do</span>\n    <span class=\"function\">set_key</span> <span class=\"string\">\"WEBSERVER/$key\"</span> <span class=\"variable\">$value</span>\n  <span class=\"keyword\">done</span>\n}\n\n<span class=\"function\">migrate_to_webserver_namespace</span></code></pre>\n\n                    <p>This script uses <a href=\"#\">Consul's REST API</a> and filters the results using <a href=\"#\">jq</a>.<sup><a href=\"#fn1\" id=\"fnref1\" aria-describedby=\"footnote-label\">1</a></sup></p>\n                    <p>It's easily adapted to migrate key-value pairs between different namespaces.</p>\n                </div>\n\n                <footer class=\"article-footer\">\n                    <aside class=\"footnotes\" role=\"doc-endnotes\">\n                        <h2 id=\"footnote-label\" class=\"sr-only\">Footnotes</h2>\n                        <ol>\n                            <li id=\"fn1\">\n                                <p>I can never remember jq's <span class=\"highlight-text\">select</span> syntax so this post is intended largely as a personal reference on how to do this. &rarr; <a href=\"#fnref1\" aria-label=\"Back to reference 1\">\u21a9</a></p>\n                            </li>\n                        </ol>\n                    </aside>\n                </footer>\n            </article>\n        </main>\n\n        <hr>\n\n        <footer class=\"page-footer\">\n            <div class=\"footer-grid\">\n                <section class=\"footer-actions\">\n                    <h3>Actions</h3>\n                    <p>Something wrong? <a href=\"#\">Suggest an improvement</a> or <a href=\"#\">add a comment</a> (see <a href=\"#\">article history</a>).</p>\n                </section>\n                <section class=\"footer-meta\">\n                    <h3>Meta</h3>\n                    <p>Filed in: <a href=\"#\">tips</a></p>\n                    <div class=\"footer-tags\">\n                        <ul>\n                            <li><a href=\"#\">consul</a></li>\n                            <li><a href=\"#\">bash</a></li>\n                            <li><a href=\"#\">jq</a></li>\n                        </ul>\n                    </div>\n                </section>\n                <nav class=\"footer-pagination\" aria-label=\"Article navigation\">\n                    <h3>Navigation</h3>\n                    <p>Previous: <a href=\"#\">Lies you're told on a software project</a></p>\n                    <p>Next: <a href=\"#\">Podcast. init on Oscar</a></p>\n                </nav>\n            </di