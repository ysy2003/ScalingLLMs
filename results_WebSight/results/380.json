-align:center\">\n      <a style=\"display:block; color:inherit !important;\" target=\"_new\">\n       <a style=\"display:block; color:inherit !important;\" target=\"_new\">\n        <img height\"198\" src=\"rick.jpg\" width=\"132\">\n        <img height\"198\" src=\"rick.jpg\" width=\"132\">\n       </a>\n      </a>\n     </div>\n     <p>\n      See larger Screenshots below..\n     </p>\n    </div>\n   </fieldset>\n   <fieldset>\n    <a class=\"button\" target=\"_new\">\n     View All Screenshots\n    </a>\n   </fieldset>\n  </panel>\n  <center>\n   Advertisements\n  </center>\n  <br>\n  <panel>\n   <fieldset style=\"clear:both\">\n    <label>\n     What's New\n    </label>\n    <div>\n     iOS 8.4 support\n     <br>\n     iPhone 6/6+ screen size support\n     <br>\n     <!--\nv 1.3<br>\nOptimized for iOS 7<br>\nBetter display for iPhone 3gs, 4/4s, 5/5s<br>\nCompatible with iOS 5, 6, or 7<br>\nShows gain in dBM from previous boost<br>\nFaster performance<br>\n\n\nv 1.2<br>\nSignal Booster now shows the gain in signal dBm from your last boost<Br>\nFaster performance<br>\n-->\n    </div>\n   </fieldset>\n  </panel>\n  <panel>\n   <fieldset style=\"clear:both\">\n    <label>\n     Information\n    </label>\n    <div>\n     <table border=\"0\" class=\"information\" cols=\"2\">\n      <tbody>\n       <tr>\n        <td class=\"key\">\n         Updated\n        </td>\n        <td class=\"detail\">\n         November 11, 2015\n        </td>\n       </tr>\n       <tr>\n        <td class=\"key\">\n         License\n        </td>\n        <td class=\"detail\">\n         Commercial&nbsp;Package\n        </td>\n       </tr>\n       <tr>\n        <td class=\"key\">\n         Suggested Price\n        </td>\n        <td class=\"detail\">\n         $ 0.99\n        </td>\n       </tr>\n      </tbody>\n     </table>\n    </div>\n   </fieldset>\n   <fieldset style=\"clear:both\">\n    <a class=\"button\">\n     Developer Website\n    </a>\n   </fieldset>\n   <fieldset style=\"clear:bo