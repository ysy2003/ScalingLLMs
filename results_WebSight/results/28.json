  "response_text": "<html>\n<style>\nbody {\n    font-family: Arial, sans-serif;\n    margin: 0;\n    padding: 0;\n    color: #333;\n}\n\n.container {\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 20px;\n}\n\n.header {\n    background-color: #00ABC3;\n    color: #fff;\n    padding: 20px;\n    text-align: center;\n}\n\n.content {\n    display: flex;\n    justify-content: space-between;\n}\n\n.left-column {\n    width: 70%;\n    padding: 20px;\n}\n\n.right-column {\n    width: 30%;\n    padding: 20px;\n}\n\n.schedule-item {\n    margin-bottom: 20px;\n}\n\n.schedule-item h3 {\n    color: #00ABC3;\n    margin-bottom: 10px;\n}\n\n.schedule-item p {\n    color: #666;\n}\n\n.image-placeholder {\n    width: 100px;\n    height: 100px;\n    background-color: #00ABC3;\n    margin-bottom: 20px;\n}\n</style>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>Schedule</h1>\n        </div>\n        <div class=\"content\">\n            <div class=\"left-column\">\n                <h2>Schedule by Location</h2>\n                <div class=\"schedule-item\">\n                    <h3>Bali, Indonesia</h3>\n                    <p>August 15 - 22</p>\n                    <p>Fly to Bali, stay in a luxurious hotel, and enjoy the sunset.</p>\n                    <div class=\"image-placeholder\"></div>\n                </div>\n                <!-- More schedule items for Bali -->\n                <div class=\"schedule-item\">\n                    <h3>New York, NYC</h3>\n                    <p>September 10 - 17</p>\n                    <p>Fly to NYC, stay in a luxurious hotel, and enjoy the city's vibrant nightlife.</p>\n                    <div class=\"image-placeholder\"></div>\n                </div>\n                <!-- More schedule items for NYC -->\n            </div>\n            <div class=\"right-column\">\n                <h2>Schedule by Date</h2>\n                <div class=\"schedule-item\">\n                    <h3>August 20, 2022</h3>\n                    <p>Fly to Bali, stay in a luxurious hotel, and enjoy the sunset.</p>\n                    <div class=\"image-placeholder\"></div>\n                </div>\n                <!-- More schedule items for August 20 -->\n                <div class=\"schedule-item\">\n                    <h3>September 15, 2022</h3>\n                    <p>Fly to NYC, stay in a luxurious hotel, and enjoy the city's vibrant nightlife.</p>\n                    <div class=\"image-placeholder\"></div>\n                </div>\n                <!-- More schedule items for September 15 -->\n            </div>\n        </div>\n    </div>\n</body>\n</html>",
  "ground_truth": "<!DOCTYPE html>\n<html lang=\"en-US\">\n <head>\n  <style>\n   /* fonts */\n   \n   @font-face \n   {\n      font-family: 'Font Awesome 5 Brands'; font-style: normal; font-weight: normal;\n      src: url('fonts/fa-brands-400.woff2') format('woff2'), url('fonts/fa-brands-400.woff') format('woff');\n   }\n   .fab { font-family: 'Font Awesome 5 Brands'; }\n   @font-face \n   {\n      font-family: 'Font Awesome 5 Pro'; font-style: normal; font-weight: 900;\n      src: url('fonts/fa-solid-900.woff2') format('woff2'), url('fonts/fa-solid-900.woff') format('woff');\n   }\n   .fa, .fas { font-family: 'Font Awesome 5 Pro'; font-weight: 900; }\n\n   /* resets */\n   \n   * \n   { \n      box-sizing: border-box; border: none; outline: none; text-rendering: optimizeLegibility;\n      -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; font-kerning: auto; \n   }\n   html { height: 100%; -webkit-text-size-adjust: 100%; }\n   body { margin: 0px; padding: 0px; color: #000000; background-color: #FFFFFF; }\n   *:before, *:after { box-sizing: inherit; }\n   .cf:before, .cf:after { content: \" \"; display: table; }\n   .cf:after { clear: both; }\n   table { border: 0; padding: 0; border-spacing: 0px; border-collapse: collapse; }   \n   tr { text-align: left; }\n   table.schedule tr:first-child td { border-top: 1px solid #CCCCCC; }\n   table.schedule td { padding: 9px 15px 9px 0px; border-bottom: 1px solid #CCCCCC; }\n   table.schedule td:first-child { white-space: nowrap; }\n   table.schedule td:last-child { padding-right: 0px; }\n   tr { vertical-align: top; }\n   body.modal-open { overflow: hidden; position: fixed; } /* stop scroll when modal open */\n   sup, sub { vertical-align: baseline; position: relative; top: -0.4em; }\n   sub { top: 0.4em; }\n   \n   /* fixed aspect ratio */\n   \n   .aspect::before { content: ''; padding-top: 100%; float: left; }\n   .aspect::after { content: ''; display: block; clear: both; }\n   \n   /* type */\n   \n   body, input, textarea, select { font: 300 16px/23px 'Montserrat', sans-serif; }\n   b { font-weight: 700; }\n   p, h2, h3, h4, h5 { margin: 20px 0px; padding: 0px; }\n   h2 { font: 700 32px/32px 'Montserrat', sans-serif; }\n   h3 { font: 700 26px/30px 'Montserrat', sans-serif; }\n   h4 { font: 500 20px/24px 'Montserrat', sans-serif; }\n   h5 { font: 700 16px/20px 'Roboto Condensed', sans-serif; color: #E32C22; text-transform: uppercase; letter-spacing: 1px; }\n   .date { font: 700 16px/20px 'Roboto Condensed', sans-serif; color: #000000; }\n   .location { font: 500 13px/18px 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 1px; }\n   dd { padding: 0px; margin: 20px 0px 20px 40px; }\n   small, .small { font-size: 85%; line-height: 100%; }\n   .placeholder { padding-bottom: 400px; }\n   ul.loose li { margin-bottom: 10px; }\n   \n   /* links */\n   \n   a { color: #00B0B5; text-decoration: none; }\n   a:hover { color: #E32C22; }\n   .btn, a.btn, a.btn:visited \n   {\n      color: #00B0B5; background-color: transparent; border: 1px solid #00B0B5; padding: 4px 10px 3px 10px;\n      font: 700 16px/16px 'Roboto Condensed', sans-serif; cursor: pointer;\n      text-transform: uppercase; letter-spacing: 1px; white-space: nowrap;\n   }\n   .btn:hover, a.btn:hover { color: #FFFFFF; background-color: #E32C22; border-color: #E32C22; }\n   \n   /* badge */\n   \n   #pmd { display: block; position: fixed; top: 0px; left: 0px; width: 260px; padding: 38px 50px; background-color: #FFFFFF; }\n   #pmd .badge \n   { \n      display: block; width: 100%; height: 0; padding-top: 100%; \n      background: transparent url('images/pmd-cpa.svg') top center no-repeat; background-size: contain;\n   }\n   \n   /* images */\n   \n   img { border: 0px; }\n   img.photo, img.right { width: 100%; height: auto; }\n   img.right { float: right; width: 33%; max-width: 500px; margin: 0px 0px 30px 30px; }\n   img.logo { height: 75px; width: auto; display: inline-block; margin: 0px 40px 0px 0px; }\n   .footer img.logo { height: 70px; margin-bottom: 20px; }\n   .footer img.logo.westphal { height: 80px; margin-bottom: 10px; }\n   .footer a:hover img.logo { opacity: 0.8; }\n   img.hero { width: 100%; height: auto; display: block; margin: 0px 0px 30px 0px; }\n   \n   /* menu */\n   \n   #nav \n   { \n      position: fixed; top: 0px; right: 0px; left: 260px; display: flex; z-index: 100;\n      justify-content: space-between; align-items: center;\n      background-color: #00B0B5; padding: 0px 12px; font: 700 18px/18px 'Roboto Condensed', sans-serif; \n   }\n   #nav a { color: #FFFFFF; display: inline-block; padding: 10px 8px; }\n   #nav a:hover { color: #000000; }\n   #nav ul { list-style-type: none; margin: 0px; padding: 0px; }\n   #nav ul li { display: inline-block; text-transform: lowercase; }\n   #nav ul li .fab { font-weight: normal; }\n   \n   /* main menu */\n\n   #nav ul.menu > li > ul \n   { \n      position: absolute; display: none; list-style-type: none; margin: 0px; padding: 8px 0px 8px 0px;\n      z-index: 12; background-color: #007649; float: none;\n   }\n   #nav ul.menu > li:hover > ul { display: block; -webkit-animation: slidein 0.1s ease-in 1; }\n   #nav ul.menu > li > ul > li { float: none; margin: 0px; padding: 0px; display: block; }  \n   #nav ul.menu > li > ul > li > a \n   { \n      display: block; padding: 3px 15px 3px 10px; font-size: 90%; line-height: 100%; \n      text-transform: lowercase;\n   } \n   #nav ul.menu > li > ul > li > a:hover { color: rgba(255,255,255,0.7); }\n   @-webkit-keyframes slidein { 0% { margin-top: -10px; opacity: 0; } 100% { margin-top: 0px; opacity: 1; } }\n   \n   /* mobile nav modal */\n   \n   #modal \n   { \n      position: fixed; top: 0px; right: 0px; left: 0px; height: 100%; z-index: 200; display: none; \n      color: #FFFFFF; background-color: #00B0B5; \n   }\n   #modal ul.menu \n   { \n      font-size: 5vh; line-height: 3vh; margin: 0px; padding: 0px 0px 0px 28px; list-style-type: none; \n      text-transform: lowercase; \n   }\n   #modal ul.menu ul { display: none; }\n   #modal .closemodal { text-align: right; font-size: 24px; cursor: pointer; }\n   #modal a, #modal .closemodal { color: #FFFFFF; display: block; padding: 12px; }\n   #modal a:hover, #modal .closemodal:hover { color: #000000; }\n   \n   /* content areas */\n   \n   .content { margin: 120px 50px 50px 260px; }\n   .footer { color: #CCCCCC; background-color: #000000; padding: 30px 50px; font-size: 90%; }\n   .footer.prefix { padding-bottom: 0px; margin-bottom: 0px; }\n   .content a, .footer a { font-weight: 500; }\n   \n   /* columns */\n   \n   .columnar { display: flex; flex-wrap: wrap; align-items: flex-start; align-content: flex-start; margin-right: -50px; }\n   .columnar > div { margin: 0px 50px 30px 0px; }\n   \n   /* tiles */\n   \n   .tiles { display: flex; flex-wrap: wrap; align-items: stretch; align-content: flex-start; }\n   .tile \n   { \n      width: 24%; position: relative; background-color: #EFEFEF; margin: 0 1% 1vh 0; \n      background-position: center center; background-repeat: no-repeat; background-size: cover;\n   }\n   .tile::before { content: ''; padding-top: 100%; float: left; }\n   .tile::after { content: ''; display: block; clear: both; }\n   .tile .caption \n   { \n      position: absolute; bottom: 0px; left: 0px; padding: 4px 8px; color: #FFFFFF; background-color: rgba(0,0,0,0.6); \n      display: inline-block;\n   }\n   .tile:hover .caption { background-color: #E32C22; }\n   \n   /* video */\n   \n   .video-container { overflow: hidden; height: 0; padding-bottom: 56.25%; position: relative; margin-bottom: 30px; }\n   .video-container iframe { position:absolute; left: 0; top: 0; height: 100%; width: 100%; }\n   \n   /* home page variants */\n   \n   body.home #nav { left: 0px; padding-left: 90px; }\n   body.home #csv-cpa { width: 100%; height: auto; }\n   body.home .footer { padding-left: 100px; }\n   .zone { display: flex; justify-content: space-between; align-items: stretch; width: 100%; }\n   .zone .primary { width: 50%; padding: 100px; }\n   .zone .secondary { width: 50%; min-height: 100vh; }\n   #zone-welcome .primary { align-self: center; }\n   #zone-welcome .primary p { margin-left: 4.44%; margin-top: 40px; font-size: 110%; line-height: 125%; }\n   #zone-welcome .secondary { display: flex; flex-direction: column; justify-content: space-between; align-items: stretch; }\n   #zone-welcome .secondary .poster \n   { \n      background: #BCE2D7 url('images/zone1.jpg') center center no-repeat; background-size: cover; \n      flex-basis: 98%; flex-shrink: 1;\n   }\n   @media screen and (orientation:portrait) { #zone-welcome .secondary .poster { background-position: right center; } }\n   #zone-welcome .secondary .linkage\n   {\n      display: flex; justify-content: space-between; align-items: stretch; flex-shrink: 1;\n   }  \n   #zone-welcome .secondary .linkage a:first-child { background: #EA308F url('images/link-enticed.jpg') center center no-repeat; background-size: 0px 0px; }\n   #zone-welcome .secondary .linkage a:last-child { background: #F47E2D url('images/link-engaged.jpg') center center no-repeat; background-size: 0px 0px; }\n   #zone-welcome .secondary .linkage a { flex-basis: 50%; padding: 30px; color: #FFFFFF; }\n   #zone-welcome .secondary .linkage a:hover { background-size: cover; }\n   #zone-welcome .secondary .linkage a .label { font-size: 2.5vw; line-height: 2.5vw; }\n   #zone-welcome .secondary .linkage a .date { margin: 10px 0px; }\n   #zone-welcome .secondary .linkage a .control { text-align: right; padding-bottom: 30px; font-size: 18px; line-height: 18px; }\n   #zone-welcome .secondary .linkage a:hover .control { color: #000000; }\n   \n   #zone-fringe \n   { \n      background: #000000 url('images/zone2.jpg') left top no-repeat; background-size: cover; background-attachment: fixed; \n   }\n   #zone-fringe .primary { color: #FFFFFF; background-color: rgba(0,0,0,0.65); }\n   #zone-fringe .primary h5 { color: #EA308F; }\n   #zone-barnes \n   { \n      background: #FFFFFF url('images/zone3a.jpg') right center no-repeat; background-size: cover; background-attachment: fixed; \n   }\n   #zone-barnes .primary { background-color: rgba(255,255,255,0.85); }\n   #zone-barnes .primary h5 { color: #f47e2d; }\n   #zone-barnes .primary .photo { max-width: 500px; margin: 0px 0px 30px 0px; }\n   \n   /* scroll-to-top control */\n   \n   a#totop\n   {  \n      position: fixed; width: 100px; height: 100px; bottom: 0px; left: 50%; margin-left: -50px; margin-bottom: -55px; \n      z-index: 25; text-align: center; color: #FFFFFF; background-color: #00B0B5; border-radius: 50px; display: none; \n      font-size: 34px; line-height: 48px; z-index: 150;\n   }\n   a#totop:hover { color: #FFFFFF; background-color: #E32C22; }\n   \n   /* large desktop */\n   \n   @media screen and (min-width: 1800px)\n   {\n      body, input, textarea, select { font-size: 125%; line-height: 150%; }\n      #zone-welcome .primary p { font-size: 150%; line-height: 150%; }\n      .date, h5 { font-size: 22px; line-height: 28px; }\n      h2 { font-size: 40px; line-height: 40px; }\n      h4 { font-size: 26px; line-height: 32px; }\n   }\n\n   /* standard desktop + tablet landscape */\n   \n   @media screen and (max-width: 1200px)\n   {\n      body.home #nav { padding-left: 50px; }\n      body.home .footer { padding-left: 60px; }\n      .zone .primary { padding: 80px 60px 60px 60px; }\n   }\n   \n   /* tablet portrait (avg 768) */\n   \n   @media screen and (max-width: 990px)\n   {\n      #nav { left: 90px; justify-content: flex-end; }\n      #nav .menu { display: none; }\n      .content { margin-left: 90px; margin-right: 25px; }\n      #pmd { width: 90px; padding: 40px 35px; }\n      #pmd .badge { padding-top: 350%; background-image: url('images/pmd.svg'); }\n      #zone-welcome .secondary .linkage a { padding: 20px; }\n      #zone-welcome .secondary .linkage a .control { padding-bottom: 20px; }\n      .footer { padding: 30px 35px; }\n      .tile { width: 32%; }\n   }\n   \n   /* mobile only */\n   \n   @media screen and (min-width: 991px) \n   { \n      #nav ul li.mobileonly { display: none; } \n   }\n   \n   /* home layout switch */\n   \n   @media screen and (max-width: 750px)\n   { \n      #zone-welcome .primary p { color: #000000; font-size: 100%; line-height: 125%; }\n      #zone-welcome .secondary .linkage a .label { font-weight: 500; }\n      #zone-fringe .secondary, #zone-barnes .secondary { display: none; }\n      #zone-fringe .primary, #zone-barnes .primary { width: 100%; }\n      .footer, body.home .footer { padding-bottom: 60px; }\n      .footer.prefix, body.home .footer.prefix { padding-bottom: 0px; }\n   }\n   \n   /* phone (avg 360) */\n   \n   @media screen and (max-width: 600px)\n   {\n      #nav { left: 40px; }\n      .content { margin-left: 40px; margin-top: 80px; }\n      #pmd { width: 40px; height: 29px; padding: 0px; }\n      #pmd .badge { background-position: center 6px; background-size: auto 29px; padding: 0px; width: 100%; height: 60px; }\n      h2 { font-size: 24px; line-height: 24px; }\n      .footer, body.home .footer { padding-left: 40px; }\n      \n      img.photo, img.right { width: 50%; height: auto; }\n      img.right { float: none; max-width: 50%; margin: 0px 0px 20px 0px; }\n      \n      .tile { width: 48%; margin: 0% 2% 2% 0%; }\n      \n      .zone .primary { padding: 60px 40px 40px 40px; }\n      #zone-welcome { flex-wrap: wrap; }\n      #zone-welcome .primary { padding-top: 80px; }\n      #zone-welcome .primary, #zone-welcome .secondary { width: 100%; }\n      #zone-welcome .secondary { background-color: #EFEFEF; }\n      #zone-welcome .secondary .linkage a .label { font-size: 4vw; line-height: 4vw; font-weight: 700; }\n      #zone-barnes .primary .photo { width: 100%; max-width: 100%; }\n   }  \n   \n   /* print */\n\n   @media print\n   {\n      #nav, #pmd, .footer .logo, a#totop { display: none; }\n      .footer, body.home .footer \n      { \n         color: #999999; background-color: #FFFFFF; margin: 30px 0px 0px 0px; padding: 20px 0px 0px 0px; border-top: 1px solid #CCCCCC;\n      }\n      .content { margin: 0px; }\n      a#totop { color: transparent; background-color: transparent; width: 1; height: 1; overflow: hidden; }\n   }\n  </style>\n  <meta charset=\"utf-8\">\n  <meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-Type\">\n  <meta content=\"width=device-width, initial-scale=1\" name=\"viewport\">\n  <title>\n   Philadelphia Museum of Dance &ndash; Schedule\n  </title>\n </head>\n <body class=\"schedule\">\n  <a id=\"top\" name=\"#top\">\n  </a>\n  <div id=\"nav\">\n   <ul class=\"menu\">\n    <li>\n     <a>\n      Schedule\n     </a>\n    </li>\n    <li>\n     <a>\n      The Artists\n     </a>\n     <ul>\n      <li>\n       <a>\n        Boris Charmatz\n       </a>\n      </li>\n      <li>\n       <a>\n        Valerie Amiss\n       </a>\n      </li>\n      <li>\n       <a>\n        Rebecca Arends\n       </a>\n      </li>\n      <li>\n       <a>\n        Lori Belilove &amp;\n        <nobr>\n         Isadora Duncan\n        </nobr>\n       </a>\n      </li>\n     </ul>\n    </li>\n    <li>\n     <a>\n      The Curators\n     </a>\n     <ul>\n      <li>\n       <a>\n        Boris Charmatz\n       </a>\n      </li>\n      <li>\n       <a>\n        Dr. Miriam Giguere\n       </a>\n      </li>\n      <li>\n       <a>\n        Lois Welk\n       </a>\n      </li>\n      <li>\n       <a>\n        Simon Dove\n       </a>\n      </li>\n     </ul>\n    </li>\n    <li>\n     <a>\n      Press\n     </a>\n    </li>\n   </ul>\n   <ul class=\"social\">\n    <li>\n     <a class=\"fab\" target=\"_blank\" title=\"instagram\">\n      <i class=\"fab fa-instagram\">\n      </i>\n     </a>\n    </li>\n    <li>\n     <a class=\"fab\" target=\"_blank\" title=\"facebook\">\n      <i class=\"fab fa-facebook-f\">\n      </i>\n     </a>\n    </li>\n    <li>\n     <a class=\"fab\" target=\"_blank\" title=\"twitter\">\n      <i class=\"fab fa-twitter\">\n      </i>\n     </a>\n    </li>\n    <li>\n     <a class=\"fas\" target=\"_blank\" title=\"mailing list\">\n      <i class=\"fas fa-envelope\">\n      </i>\n     </a>\n    </li>\n   </ul>\n  </div>\n  <a id=\"pmd\">\n   <div class=\"badge\">\n   </div>\n  </a>\n  <div class=\"content\">\n   <h2>\n    Schedule\n   </h2>\n   <br>\n   <h3>\n    <i>\n     manger\n    </i>\n    by Boris Charmatz\n   </h3>\n   <h5>\n    September 22-23, 2018 &middot; 8&ndash;9 PM\n   </h5>\n   <p>\n    FringeArts\n    <br>\n    140 N Columbus Blvd (at Race St)\n    <br>\n    Philadelphia, PA 19106\n   </p>\n   <br>\n   <h3>\n    Philadelphia Museum of Dance\n   </h3>\n   <h5>\n    October 6, 2018 &middot; 3&ndash;9 PM\n   </h5>\n   <p>\n    Barnes Foundation\n    <br>\n    2025 Benjamin Franklin Parkway\n    <br>\n    Philadelphia, PA 19130\n    <br>\n    [PHONE REDACTED]\n   </p>\n   <p>\n    FREE EVENT &middot; Just walk up. Stop by for an hour or stay for all six.\n   </p>\n   <h4>\n    Schedule\n   </h4>\n   <table class=\"schedule\">\n    <tbody>\n     <tr>\n      <td class=\"date\">\n       3&ndash;4 pm\n      </td>\n      <td>\n       <b>\n        <a>\n         Public warm-up led by Boris Charmatz and Romain Big&eacute;\n        </a>\n       </b>\n       <br>\n       <span class=\"location\">\n        West Terrace, Main Floor\n       </span>\n       <br>\n       Join In&mdash;the audience is invited to participate\n      </td>\n     </tr>\n     <tr>\n      <td class=\"date\">\n       4&ndash;4:30 pm\n      </td>\n      <td>\n       <b>\n        <a>\n         A medley of choreographed and freestyle pieces by It&rsquo;s Showtime NYC!\n        </a>\n       </b>\n       <br>\n       <span class=\"location\">\n        West Terrace, Main Floor\n       </span>\n      </td>\n     </tr>\n     <tr>\n      <td>\n      </td>\n      <td>\n       <b>\n        <a>\n         STAGED? (2016) _\n         <i>\n          undressed\n         </i>\n         by Maria Hassabi\n        </a>\n       </b>\n       <br>\n       <span class=\"location\">\n        Main Entrance, outside\n       </span>\n      </td>\n     </tr>\n     <tr>\n      <td class=\"date\">\n       4:30&ndash;4:45 pm\n      </td>\n      <td>\n       <b>\n        <a>\n         <i>\n          1973,\n         </i>\n         a collective dance proposed by Boris Charmatz, \n         performed by local college students\n        </a>\n       </b>\n       <br>\n       <span class=\"location\">\n        Annenberg Court, Main Floor\n       </span>\n      </td>\n     </tr>\n    </tbody>\n   </table>\n   <h4>\n    Rain or Shine\n   </h4>\n   <p>\n    Philadelphia Museum of Dance will take place rain or shine. Outside performance locations for the Solo Forest \n   may be inside if it rains.\n   </p>\n   <h4>\n    Times to Remember\n   </h4>\n   <p>\n    <span class=\"date\">\n     5 pm\n    </span>\n    &middot; Barnes collection and parking lot close\n    <br>\n    <span class=\"date\">\n     9 pm\n    </span>\n    &middot; Event ends and building closes\n   </p>\n  </div>\n  <div class=\"footer\">\n   <a target=\"_blank\">\n    <img class=\"logo\" src=\"rick.jpg\">\n   </a>\n   <a target=\"_blank\">\n    <img class=\"logo westphal\" src=\"rick.jpg\">\n   </a>\n   <a target=\"_blank\">\n    <img class=\"logo\" src=\"rick.jpg\">\n   </a>\n   <a target=\"_blank\">\n    <img class=\"logo\" src=\"rick.jpg\">\n   </a>\n   <br>\n   Support for Philadelphia Museum of Dance has been provided to Westphal College of Media Arts &amp; Design by\n   <a target=\"_blank\">\n    The Pew Center for Arts &amp; Heritage\n   </a>\n   . Philadelphia Museum of Dance \n         is produced in partnership with the Barnes Foundation. Performances of\n   <i>\n    manger\n   </i>\n   are presented in partnership \n         with FringeArts.\n   <br>\n   <br>\n   Copyright &copy; 2023,\n   <a target=\"_blank\">\n    Westphal College of Media Arts &amp; Design\n   </a>\n   ,\n   <nobr>\n    <a targe