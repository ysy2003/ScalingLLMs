ack</option>\n                <option value=\"suv\">SUV</option>\n                <option value=\"sport\">Sport</option>\n                <option value=\"electric\">Electric</option>\n            </select>\n            <p>What color is it?</p>\n            <select>\n                <option value=\"\">--Select--</option>\n                <option value=\"red\">Red</option>\n                <option value=\"blue\">Blue</option>\n                <option value=\"green\">Green</option>\n                <option value=\"black\">Black</option>\n                <option value=\"white\">White</option>\n                <option value=\"silver\">Silver</option>\n                <option value=\"gold\">Gold</option>\n            </select>\n            <p>What is the mileage?</p>\n            <input type=\"number\" min=\"0\" max=\"1000000\">\n            <p>What is the horsepower?</p>\n            <input type=\"number\" min=\"0\" max=\"1000\">\n            <p>What is the price?</p>\n            <input type=\"number\" min=\"0\" max=\"1000000\">\n            <button>Submit</button>\n        </div>\n        <div class=\"footer\">\n            <p>Thank you for taking our quiz. We'll be in touch soon to let you know the results.</p>\n            <p>© 2022-Carole &lt;333&gt; Pricing &lt;333&gt; Amenities &lt;333&gt;</p>\n        </div>\n    </div>\n</body>\n</html>",
